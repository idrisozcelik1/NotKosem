<Window x:Class="NotKosem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem"
        Width="360"
        Height="500"
        MinWidth="300"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="MainWindow_Closing"
        Topmost="True">

	<Border x:Name="MainBorder"
            Background="#FFF2C6"
            Opacity="1"
            CornerRadius="14"
            BorderBrush="#D6D6D6"
            BorderThickness="1">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="48"/>
				<RowDefinition Height="42"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="35"/>
			</Grid.RowDefinitions>

			<!-- ÜST BÖLÜM -->
			<Border Grid.Row="0"
                    Background="#F4F1E8"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

				<Grid Margin="10,5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="40"/>
						<ColumnDefinition Width="35"/>
						<ColumnDefinition Width="30"/>
					</Grid.ColumnDefinitions>

					<ComboBox x:Name="NoteList"
                              Grid.Column="0"
                              DisplayMemberPath="Title"
                              SelectionChanged="NoteList_SelectionChanged"
                              VerticalContentAlignment="Center"
                              ToolTip="Notlarım"/>

					<Button Grid.Column="1"
                            Content="+"
                            Margin="5,0,0,0"
                            FontSize="21"
                            FontWeight="Bold"
                            Click="NewNoteButton_Click"
                            ToolTip="Yeni not oluştur"/>

					<Button Grid.Column="2"
                            Content="📌"
                            Click="PinButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Üstte tut"/>

					<Button Grid.Column="3"
                            Content="×"
                            FontSize="20"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6A5235"
                            ToolTip="Gizle"/>
				</Grid>
			</Border>

			<!-- AYAR İKONLARI -->
			<Grid Grid.Row="1"
                  Margin="10,3">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="🎨"
                        FontSize="17"
                        Click="ColorSettingsButton_Click"
                        ToolTip="Not rengi"/>

				<Button Grid.Column="1"
                        Content="◐"
                        FontSize="19"
                        Click="OpacitySettingsButton_Click"
                        ToolTip="Saydamlık"/>

				<Button Grid.Column="2"
                        Content="🔔"
                        FontSize="16"
                        Click="ReminderSettingsButton_Click"
                        ToolTip="Hatırlatıcı"/>

				<Button Grid.Column="3"
                        Content="▦"
                        FontSize="19"
                        Click="CategorySettingsButton_Click"
                        ToolTip="Kategori"/>
			</Grid>

			<!-- AYAR PANELİ -->
			<Border x:Name="SettingsPanel"
                    Grid.Row="2"
                    Margin="10,3,10,6"
                    Padding="10"
                    Background="#40FFFFFF"
                    CornerRadius="8"
                    Visibility="Collapsed">

				<Grid>

					<!-- RENK AYARI -->
					<StackPanel x:Name="ColorSettingsPanel"
                                Visibility="Collapsed">

						<TextBlock Text="Not Rengi"
                                   FontWeight="SemiBold"
                                   Foreground="#5C5132"
                                   Margin="0,0,0,7"/>

						<ComboBox x:Name="ColorSelector"
                                  SelectedIndex="0"
                                  SelectionChanged="ColorSelector_SelectionChanged">

							<ComboBoxItem Content="Sarı"
                                          Tag="#FFF2C6"/>

							<ComboBoxItem Content="Mavi"
                                          Tag="#D9EDFF"/>

							<ComboBoxItem Content="Yeşil"
                                          Tag="#DDF5DC"/>

							<ComboBoxItem Content="Pembe"
                                          Tag="#FFE0E8"/>

							<ComboBoxItem Content="Mor"
                                          Tag="#EAE0FF"/>

							<ComboBoxItem Content="Beyaz"
                                          Tag="#FFFFFF"/>
						</ComboBox>
					</StackPanel>

					<!-- SAYDAMLIK AYARI -->
					<StackPanel x:Name="OpacitySettingsPanel"
                                Visibility="Collapsed">

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="45"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="Saydamlık"
                                       FontWeight="SemiBold"
                                       Foreground="#5C5132"
                                       VerticalAlignment="Center"/>

							<TextBlock x:Name="OpacityValueText"
                                       Grid.Column="1"
                                       Text="%100"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
						</Grid>

						<Slider x:Name="OpacitySlider"
                                Minimum="0.3"
                                Maximum="1"
                                Value="1"
                                Margin="0,8,0,0"
                                ValueChanged="OpacitySlider_ValueChanged"/>

						<Button Content="Saydamlığı Sıfırla"
                                Margin="0,7,0,0"
                                Click="ResetOpacityButton_Click"/>
					</StackPanel>

					<!-- HATIRLATICI AYARI -->
					<StackPanel x:Name="ReminderSettingsPanel"
                                Visibility="Collapsed">

						<TextBlock Text="Hatırlatıcı"
                                   FontWeight="SemiBold"
                                   Foreground="#5C5132"
                                   Margin="0,0,0,7"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="85"/>
							</Grid.ColumnDefinitions>

							<DatePicker x:Name="ReminderDatePicker"
                                        Grid.Column="0"
                                        SelectedDateFormat="Short"/>

							<TextBox x:Name="ReminderTimeTextBox"
                                     Grid.Column="1"
                                     Text="09:00"
                                     Margin="5,0,0,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     ToolTip="Saat (Örnek: 14:30)"/>
						</Grid>

						<Grid Margin="0,7,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Button Grid.Column="0"
                                    Content="Kaydet"
                                    Margin="0,0,3,0"
                                    Click="SetReminderButton_Click"/>

							<Button Grid.Column="1"
                                    Content="İptal Et"
                                    Margin="3,0,0,0"
                                    Click="CancelReminderButton_Click"/>
						</Grid>

						<TextBlock x:Name="ReminderStatusText"
                                   Text="Hatırlatıcı ayarlanmadı."
                                   FontSize="10"
                                   Foreground="#806B42"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
					</StackPanel>

					<!-- KATEGORİ AYARI -->
					<StackPanel x:Name="CategorySettingsPanel"
                                Visibility="Collapsed">

						<TextBlock Text="Not Kategorisi"
                                   FontWeight="SemiBold"
                                   Foreground="#5C5132"
                                   Margin="0,0,0,7"/>

						<ComboBox x:Name="CategorySelector"
                                  SelectionChanged="CategorySelector_SelectionChanged"/>

						<Grid Margin="0,7,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="85"/>
							</Grid.ColumnDefinitions>

							<TextBox x:Name="NewCategoryTextBox"
                                     Grid.Column="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Yeni kategori adı"
                                     Margin="0,0,5,0"/>

							<Button Grid.Column="1"
                                    Content="Ekle"
                                    Click="AddCategoryButton_Click"/>
						</Grid>
					</StackPanel>

				</Grid>
			</Border>

			<!-- NOT ALANI -->
			<Grid Grid.Row="3"
                  Margin="14,8,14,5">

				<Grid.RowDefinitions>
					<RowDefinition Height="35"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<TextBox x:Name="NoteTitleTextBox"
                         Grid.Row="0"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#5C5132"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         BorderBrush="#D8C578"
                         VerticalContentAlignment="Center"
                         TextChanged="NoteTitleTextBox_TextChanged"
                         ToolTip="Not başlığı"/>

				<TextBox x:Name="NoteTextBox"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         FontSize="14"
                         Foreground="#5C5132"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="NoteTextBox_TextChanged"
                         Padding="0"/>
			</Grid>

			<!-- ALT BÖLÜM -->
			<Grid Grid.Row="4"
                  Margin="10,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="NoteCountText"
                           Text="Not 1 / 1"
                           FontSize="11"
                           Foreground="#9B8755"
                           VerticalAlignment="Center"/>

				<Button Grid.Column="1"
                        Content="Sil"
                        Click="DeleteNoteButton_Click"
                        Padding="12,2"
                        Foreground="#A33B32"
                        ToolTip="Bu notu sil"/>
			</Grid>

		</Grid>
	</Border>
</Window>