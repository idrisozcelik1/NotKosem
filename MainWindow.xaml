<Window x:Class="NotKosem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem"
        Width="410"
        Height="680"
        MinWidth="340"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="MainWindow_Closing"
        Icon="Assets/NotKosem.ico"
        Topmost="False">

    <Window.Resources>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFFDF8"/>
            <Setter Property="Foreground" Value="#5C5132"/>
            <Setter Property="BorderBrush" Value="#D8CBAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0E8D5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E5D8B9"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#FFFFFF"
            BorderBrush="#9C8B67"
            BorderThickness="2"
            CornerRadius="15"
            ClipToBounds="True">

        <Grid Margin="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="43"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAŞLIK -->
            <Border Grid.Row="0"
                    Background="#F4EEDC"
                    CornerRadius="10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NotKöşem"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#5C5132"/>

                    <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <Button x:Name="PinButton"
            Content="📌"
            Width="34"
            Height="30"
            Padding="2"
            Click="PinButton_Click"
            ToolTip="Pencereyi sabitle"/>

                        <Button Content="–"
            Width="34"
            Height="30"
            Padding="2"
            FontSize="19"
            Click="MinimizeButton_Click"
            ToolTip="Görev çubuğuna küçült"/>

                        <Button Content="×"
            Width="34"
            Height="30"
            Padding="2"
            FontSize="19"
            Click="CloseButton_Click"
            ToolTip="Sistem tepsisine gizle"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- NOT SEÇİMİ -->
            <Grid Grid.Row="1" Margin="5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="NoteList"
                          Grid.Column="0"
                          DisplayMemberPath="Title"
                          VerticalContentAlignment="Center"
                          SelectionChanged="NoteList_SelectionChanged"
                          ToolTip="Notlarım"/>

                <Button Grid.Column="1"
                        Content="+"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="5,0,0,0"
                        Padding="2"
                        Click="NewNoteButton_Click"
                        ToolTip="Yeni not oluştur"/>
            </Grid>

            <!-- AYAR İKONLARI -->
            <Grid Grid.Row="2" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="🎨 Görünüm"
                        Click="ToggleAppearancePanel_Click"/>

                <Button Grid.Column="1"
                        Content="🏷 Kategori"
                        Click="ToggleCategoryPanel_Click"/>

                <Button Grid.Column="2"
                        Content="⏰ Hatırlatıcı"
                        Click="ToggleReminderPanel_Click"/>
            </Grid>

            <!-- GÖRÜNÜM AYARLARI -->
            <Border x:Name="AppearancePanel"
                    Grid.Row="3"
                    Margin="7,3"
                    Padding="8"
                    Background="#40FFFFFF"
                    CornerRadius="9"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Not Rengi"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="ColorSelector"
                              SelectedIndex="0"
                              SelectionChanged="ColorSelector_SelectionChanged">

                        <ComboBoxItem Content="Sarı" Tag="#FFF2C6"/>
                        <ComboBoxItem Content="Mavi" Tag="#D9EDFF"/>
                        <ComboBoxItem Content="Yeşil" Tag="#DDF5DC"/>
                        <ComboBoxItem Content="Pembe" Tag="#FFE0E8"/>
                        <ComboBoxItem Content="Mor" Tag="#EAE0FF"/>
                        <ComboBoxItem Content="Beyaz" Tag="#FFFFFF"/>

                    </ComboBox>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Saydamlık"
                                   VerticalAlignment="Center"
                                   FontSize="11"/>

                        <Slider x:Name="OpacitySlider"
                                Grid.Column="1"
                                Minimum="0.3"
                                Maximum="1"
                                Value="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                ValueChanged="OpacitySlider_ValueChanged"/>

                        <TextBlock x:Name="OpacityValueText"
                                   Grid.Column="2"
                                   Text="%100"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- KATEGORİ AYARLARI -->
            <Border x:Name="CategoryPanel"
                    Grid.Row="4"
                    Margin="7,3"
                    Padding="8"
                    Background="#40FFFFFF"
                    CornerRadius="9"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Not Kategorisi"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="CategorySelector"
                              SelectionChanged="CategorySelector_SelectionChanged"/>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NewCategoryTextBox"
                                 Grid.Column="0"
                                 Height="30"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Yeni kategori adı"
                                 Margin="0,0,4,0"/>

                        <Button Grid.Column="1"
                                Content="Ekle"
                                Click="AddCategoryButton_Click"
                                Padding="12,4"/>

                        <Button Grid.Column="2"
                                Content="Sil"
                                Foreground="#A33B32"
                                Click="DeleteCategoryButton_Click"
                                Padding="12,4"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- HATIRLATICI AYARLARI -->
            <Border x:Name="ReminderPanel"
                    Grid.Row="5"
                    Margin="7,3"
                    Padding="8"
                    Background="#40FFFFFF"
                    CornerRadius="9"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Hatırlatıcı"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"
                               Margin="0,0,0,5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="ReminderDatePicker"
                                    Grid.Column="0"
                                    SelectedDateFormat="Short"/>

                        <TextBox x:Name="ReminderTimeTextBox"
                                 Grid.Column="1"
                                 Text="09:00"
                                 Margin="5,0,0,0"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Hatırlatıcı Ekle"
                                Click="SetReminderButton_Click"/>

                        <Button Grid.Column="1"
                                Content="İptal Et"
                                Click="CancelReminderButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="ReminderStatusText"
                               Text="Hatırlatıcı ayarlanmadı."
                               FontSize="10"
                               Foreground="#806B42"
                               Margin="2,4,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- YAZI BİÇİMLENDİRME -->
            <Border Grid.Row="6"
                    Margin="5,3"
                    Background="#40FFFFFF"
                    CornerRadius="8"
                    Padding="3">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Content="B"
                                Width="30"
                                FontWeight="Bold"
                                Padding="2"
                                Click="BoldButton_Click"
                                ToolTip="Kalın"/>

                        <Button Content="I"
                                Width="30"
                                FontStyle="Italic"
                                Padding="2"
                                Click="ItalicButton_Click"
                                ToolTip="İtalik"/>

                        <Button Content="U"
                                Width="30"
                                Padding="2"
                                Click="UnderlineButton_Click"
                                ToolTip="Altı çizili"/>
                    </StackPanel>

                    <ComboBox x:Name="FontFamilySelector"
                              Grid.Column="1"
                              Margin="3,0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="FontFamilySelector_SelectionChanged"
                              ToolTip="Yazı tipi"/>

                    <ComboBox x:Name="FontSizeSelector"
                              Grid.Column="2"
                              Margin="2,0"
                              SelectedIndex="3"
                              VerticalContentAlignment="Center"
                              SelectionChanged="FontSizeSelector_SelectionChanged"
                              ToolTip="Yazı boyutu">

                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="28"/>
                        <ComboBoxItem Content="32"/>

                    </ComboBox>

                    <ComboBox x:Name="TextColorSelector"
                              Grid.Column="3"
                              Margin="2,0"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="TextColorSelector_SelectionChanged"
                              ToolTip="Yazı rengi">

                        <ComboBoxItem Content="Siyah" Tag="#000000"/>
                        <ComboBoxItem Content="Kırmızı" Tag="#D32F2F"/>
                        <ComboBoxItem Content="Mavi" Tag="#1565C0"/>
                        <ComboBoxItem Content="Yeşil" Tag="#2E7D32"/>
                        <ComboBoxItem Content="Mor" Tag="#7B1FA2"/>
                        <ComboBoxItem Content="Turuncu" Tag="#EF6C00"/>

                    </ComboBox>
                </Grid>
            </Border>

            <!-- NOT BAŞLIĞI -->
            <TextBox x:Name="NoteTitleTextBox"
                     Grid.Row="7"
                     Margin="10,3"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="#5C5132"
                     Background="Transparent"
                     BorderThickness="0,0,0,1"
                     BorderBrush="#D8C578"
                     VerticalContentAlignment="Center"
                     TextChanged="NoteTitleTextBox_TextChanged"
                     ToolTip="Not başlığı"/>

            <!-- NOT İÇERİĞİ -->
            <RichTextBox x:Name="NoteRichTextBox"
                         Grid.Row="8"
                         Margin="10,5"
                         Padding="5"
                         FontSize="14"
                         Foreground="#5C5132"
                         Background="#20FFFFFF"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="NoteRichTextBox_TextChanged"
                         AcceptsTab="True">

                <FlowDocument PagePadding="0">
                    <Paragraph/>
                </FlowDocument>

            </RichTextBox>

            <!-- ALT BİLGİ -->

            <Grid Grid.Row="9" Margin="7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NoteCountText"
               Text="Not 1 / 1"
               VerticalAlignment="Center"
               Foreground="#9B8755"
               FontSize="11"/>

                <Button Grid.Column="1"
            Content="Masaüstüne Çıkar"
            Click="OpenWidgetButton_Click"
            Padding="8,3"/>

                <Button Grid.Column="2"
            Content="Sil"
            Foreground="#A33B32"
            Click="DeleteNoteButton_Click"
            Padding="10,3"/>

                <Button Grid.Column="3"
            Content="Kaydet"
            Click="SaveNoteButton_Click"
            Padding="10,3"/>
            </Grid>


        </Grid>
    </Border>
</Window>
