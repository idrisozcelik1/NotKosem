<Window x:Class="NotKosem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem"
        Width="320"
        Height="360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

	<Border Background="#FFF2C6"
            CornerRadius="14"
            BorderBrush="#E4D69E"
            BorderThickness="1">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="45"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="30"/>
			</Grid.RowDefinitions>

			<!-- Üst araç çubuğu -->
			<Border Grid.Row="0"
                    Background="#FFE8A3"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Not başlığı -->
					<TextBlock Text="NotKöşem"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"/>

					<!-- Butonlar -->
					<StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">

						<!-- Üstte tutma butonu -->
						<Button Content="📌"
                                Width="30"
                                Height="28"
                                Click="PinButton_Click"
                                ToolTip="Üstte tut"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"/>

						<!-- Kapatma butonu -->
						<Button Content="×"
                                Width="30"
                                Height="28"
                                Click="CloseButton_Click"
                                ToolTip="Kapat"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="20"
                                Foreground="#6A5235"
                                Cursor="Hand"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Not yazma alanı -->
			<TextBox Grid.Row="1"
                     x:Name="NoteTextBox"
                     Margin="14,12,14,8"
                     FontSize="15"
                     Foreground="#5C5132"
                     Background="Transparent"
                     BorderThickness="0"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="0"
                     Focusable="True"/>

			<!-- Alt bilgi -->
			<TextBlock Grid.Row="2"
                       Text="Notlarını burada tut."
                       Margin="14,0,0,8"
                       FontSize="11"
                       Foreground="#9B8755"
                       VerticalAlignment="Center"/>
		</Grid>
	</Border>
</Window>
