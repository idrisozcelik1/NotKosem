<Window x:Class="NotKosem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem"
        Width="360"
        Height="480"
        MinWidth="300"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border x:Name="MainBorder"
            Background="#FFF2C6"
            Opacity="1"
            CornerRadius="14"
            BorderBrush="#E4D69E"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAŞLIK -->
            <Border Grid.Row="0"
                    Background="#FFE8A3"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NotKöşem"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">

                        <Button Content="📌"
                                Width="30"
                                Height="28"
                                Click="PinButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button Content="×"
                                Width="30"
                                Height="28"
                                Click="CloseButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="20"
                                Foreground="#6A5235"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- NOT LİSTESİ VE YENİ NOT -->
            <Grid Grid.Row="1" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="NoteList"
                          Grid.Column="0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="NoteList_SelectionChanged"
                          DisplayMemberPath="Title"
                          ToolTip="Notlarım"/>

                <Button Grid.Column="1"
                        Content="+"
                        Margin="5,0,0,0"
                        FontSize="20"
                        FontWeight="Bold"
                        Click="NewNoteButton_Click"
                        ToolTip="Yeni not oluştur"/>
            </Grid>

            <!-- ÖNCEKİ VE SONRAKİ -->
            <Grid Grid.Row="2" Margin="10,0,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="‹ Önceki"
                        Click="PreviousNoteButton_Click"
                        Margin="0,0,3,0"/>

                <Button Grid.Column="1"
                        Content="Sonraki ›"
                        Click="NextNoteButton_Click"
                        Margin="3,0,0,0"/>
            </Grid>

            <!-- RENK SEÇİMİ -->
            <Grid Grid.Row="3" Margin="12,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Renk:"
                           VerticalAlignment="Center"
                           Foreground="#5C5132"
                           Margin="0,0,8,0"/>

                <ComboBox x:Name="ColorSelector"
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="ColorSelector_SelectionChanged"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Sarı" Tag="#FFF2C6"/>
                    <ComboBoxItem Content="Mavi" Tag="#D9EDFF"/>
                    <ComboBoxItem Content="Yeşil" Tag="#DDF5DC"/>
                    <ComboBoxItem Content="Pembe" Tag="#FFE0E8"/>
                    <ComboBoxItem Content="Mor" Tag="#EAE0FF"/>
                    <ComboBoxItem Content="Beyaz" Tag="#FFFFFF"/>

                </ComboBox>

                <Button Grid.Column="2"
                        Content="⟲"
                        Width="30"
                        Margin="5,0,0,0"
                        Click="ResetOpacityButton_Click"
                        ToolTip="Saydamlığı sıfırla"/>
            </Grid>

            <!-- SAYDAMLIK AYARI -->
            <Grid Grid.Row="4" Margin="12,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Saydamlık:"
                           VerticalAlignment="Center"
                           Foreground="#5C5132"
                           FontSize="11"/>

                <Slider x:Name="OpacitySlider"
                        Grid.Column="1"
                        Minimum="0.3"
                        Maximum="1"
                        Value="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        ValueChanged="OpacitySlider_ValueChanged"/>

                <TextBlock x:Name="OpacityValueText"
                           Grid.Column="2"
                           Text="%100"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- NOT BAŞLIĞI VE İÇERİĞİ -->
            <Grid Grid.Row="5" Margin="14,8,14,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="NoteTitleTextBox"
                         Grid.Row="0"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="#5C5132"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         BorderBrush="#D8C578"
                         VerticalContentAlignment="Center"
                         TextChanged="NoteTitleTextBox_TextChanged"
                         ToolTip="Not başlığı"/>

                <TextBox x:Name="NoteTextBox"
                         Grid.Row="1"
                         Margin="0,10,0,0"
                         FontSize="14"
                         Foreground="#5C5132"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="NoteTextBox_TextChanged"
                         Padding="0"/>
            </Grid>

            <!-- ALT BİLGİ VE SİLME -->
            <Grid Grid.Row="6" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="NoteCountText"
                           Text="Not 1 / 1"
                           FontSize="11"
                           Foreground="#9B8755"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Sil"
                        Click="DeleteNoteButton_Click"
                        Padding="12,2"
                        Foreground="#A33B32"
                        ToolTip="Bu notu sil"/>
            </Grid>

        </Grid>
    </Border>
</Window>
