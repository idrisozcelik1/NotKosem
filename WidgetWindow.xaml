<Window x:Class="NotKosem.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem Widget"
        Width="300"
        Height="250"
        MinWidth="220"
        MinHeight="160"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FFFDF8"/>
            <Setter Property="Foreground" Value="#5C5132"/>
            <Setter Property="BorderBrush" Value="#D8CBAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WidgetBorder"
            Background="#FFFFFF"
            BorderBrush="#B8A77E"
            BorderThickness="1.5"
            CornerRadius="12"
            ClipToBounds="True">

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#30FFFFFF"
                    CornerRadius="8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="WidgetTitleTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             FontWeight="SemiBold"
                             FontSize="13"
                             Foreground="#5C5132"
                             VerticalContentAlignment="Center"
                             TextChanged="WidgetTitleTextBox_TextChanged"/>

                    <Button x:Name="WidgetPinButton"
                            Grid.Column="1"
                            Content="📌"
                            Width="30"
                            Padding="2"
                            Click="WidgetPinButton_Click"
                            ToolTip="Widget'i sabitle"/>

                    <Button Grid.Column="2"
                            Content="×"
                            Width="30"
                            Padding="2"
                            FontSize="17"
                            Click="CloseWidgetButton_Click"
                            ToolTip="Widget'i masaüstünden kaldır"/>
                </Grid>
            </Border>

            <RichTextBox x:Name="WidgetRichTextBox"
                         Grid.Row="1"
                         Margin="5"
                         Padding="4"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Foreground="#5C5132"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="WidgetRichTextBox_TextChanged"
                         AcceptsTab="True">
                <FlowDocument PagePadding="0">
                    <Paragraph/>
                </FlowDocument>
            </RichTextBox>

        </Grid>
    </Border>
</Window>
