<Window x:Class="NotKosem.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotKöşem Takvim"
        Width="410"
        Height="720"
        MinWidth="340"
        MinHeight="650"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#FFFDF8"
            BorderBrush="#9C8B67"
            BorderThickness="2"
            CornerRadius="15"
            ClipToBounds="True">

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="245"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIK -->
            <Border Grid.Row="0"
                    Background="#F4EEDC"
                    CornerRadius="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Takvim"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#5C5132"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Width="34"
                            FontSize="19"
                            Padding="2"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- AY NAVİGASYONU -->
            <Grid Grid.Row="1" Margin="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="‹"
                        Click="PreviousMonthButton_Click"/>

                <TextBlock Grid.Column="1"
                           x:Name="MonthYearText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Button Grid.Column="2"
                        Content="Bugün"
                        Click="TodayButton_Click"
                        Margin="4,0"
                        Padding="8,3"
                        FontSize="11"
                        ToolTip="Bugüne dön"/>

                <Button Grid.Column="3"
                        Content="›"
                        Click="NextMonthButton_Click"/>
            </Grid>

            <!-- TAKVİM (SABİT YÜKSEKLİK) -->
            <Grid Grid.Row="2"
                  x:Name="CalendarGrid"
                  Margin="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- SEÇİLEN GÜN VE ETKİNLİK LİSTESİ (VARSAYILAN 2 SATIR + SCROLL) -->
            <Border Grid.Row="3"
                    Margin="3,4"
                    Padding="8"
                    Background="#F4EEDC"
                    CornerRadius="9">

                <StackPanel>
                    <TextBlock x:Name="SelectedDateText"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"
                               Margin="2,0,0,4"/>

                    <!-- Tam 2 etkinlik kartı yüksekliği (70px); 3+ etkinlikte kaydırılır -->
                    <ListBox x:Name="EventList"
                             Height="70"
                             Margin="0,2"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="EventList_SelectionChanged">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="1"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFDF8"
                                        BorderBrush="#D8CBAA"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        HorizontalAlignment="Stretch">

                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding EventDate, StringFormat={}{0:HH:mm}}"
                                                   Foreground="#AA692D"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#5C5132"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding Description, StringFormat={} - {0}}"
                                                   Foreground="#88806E"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="+ Yeni Etkinlik"
                                Height="26"
                                Click="AddEventButton_Click"/>

                        <Button Grid.Column="1"
                                Content="Sil"
                                Height="26"
                                Padding="10,0"
                                Margin="4,0,0,0"
                                Foreground="#A33B32"
                                Click="DeleteEventButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ETKİNLİK EKLE / DÜZENLE FORMU (HER ZAMAN AÇIK) -->
            <Border Grid.Row="4"
                    x:Name="EventEditor"
                    Margin="3,4"
                    Padding="8"
                    Background="#FFF8E8"
                    CornerRadius="9"
                    Visibility="Visible">

                <StackPanel>
                    <TextBlock x:Name="EditorHeaderText"
                               Text="Yeni Etkinlik Ekle"
                               FontWeight="SemiBold"
                               Foreground="#5C5132"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="EventTitleTextBox"
                             Height="28"
                             Padding="6,2"
                             Margin="0,2"
                             VerticalContentAlignment="Center"
                             ToolTip="Etkinlik başlığı"/>

                    <TextBox x:Name="EventDescriptionTextBox"
                             Height="44"
                             Padding="6,4"
                             Margin="0,2"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Etkinlik açıklaması"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="85"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="EventDatePicker"
                                    SelectedDateFormat="Short"/>

                        <TextBox x:Name="EventTimeTextBox"
                                 Grid.Column="1"
                                 Text="09:00"
                                 Height="26"
                                 Margin="5,0,0,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Kaydet"
                                Height="26"
                                Margin="0,0,2,0"
                                Click="SaveEventButton_Click"/>

                        <Button Grid.Column="1"
                                Content="Temizle"
                                Height="26"
                                Margin="2,0,0,0"
                                Click="CancelEventButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>